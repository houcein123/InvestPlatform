# ============================================================================
# Backend Spring Boot — variables d'environnement
# ----------------------------------------------------------------------------
# Spring Boot lit ces valeurs depuis l'environnement du processus, pas depuis
# ce fichier. Sous PowerShell : $env:DB_URL = "..." avant ./mvnw spring-boot:run
# En production, elles sont fournies par la plateforme d'hébergement.
#
# AUCUN IDENTIFIANT N'EST ÉCRIT DANS application.properties : ce fichier ne
# contient que des références à ces variables.
# ============================================================================

# ── Base de données ──
# La chaîne Neon `postgresql://user:pass@host/db?sslmode=require` se traduit
# en trois variables distinctes.
DB_URL=jdbc:postgresql://ep-xxxx.neon.tech/neondb?sslmode=require
DB_USER=votre_utilisateur
DB_PASSWORD=votre_mot_de_passe

# ── Sécurité ──
# 32 caractères minimum : le service refuse de démarrer en deçà, un secret
# court rendant les jetons falsifiables.
JWT_SECRET=changez_moi_par_une_chaine_aleatoire_d_au_moins_32_caracteres
JWT_EXPIRES_HOURS=24

# ── Réseau ──
SERVER_PORT=8080
CORS_ORIGIN=http://localhost:5173

# ── Affichage ──
DEVISE=TND

# ── Paiement ──
# simulation : la commande est validée dans la plateforme. Aucun débit, aucun
#              compte externe, aucune configuration. Mode par défaut.
# paypal     : transaction réelle via l'API Orders v2.
PAIEMENT_MODE=simulation

# ── PayPal — requis uniquement si PAIEMENT_MODE=paypal ──
# À créer sur developer.paypal.com → Apps & Credentials.
# sandbox : comptes de test, aucun argent réel
# live    : paiements réels — à ne basculer qu'en production
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Le dinar tunisien n'est pas une devise acceptée par PayPal : les tarifs
# restent affichés en TND et la transaction est présentée dans celle-ci,
# convertie à ce taux. Constante de configuration, à réviser périodiquement.
PAYPAL_CURRENCY=EUR
PAYPAL_TAUX_TND=0.29
PAYPAL_LOCALE=fr_FR

# Identifiant du webhook, nécessaire pour VÉRIFIER LA SIGNATURE des
# notifications. Sans lui, les notifications reçues sont rejetées : cette route
# est publique, la signature est sa seule authentification.
PAYPAL_WEBHOOK_ID=

# ── Moteur de rapports ──
REPORT_ENGINE_URL=http://localhost:3001
# Doit être IDENTIQUE à REPORT_ENGINE_TOKEN du moteur.
REPORT_ENGINE_TOKEN=changez_moi_par_une_chaine_aleatoire_longue
