# ── Neon PostgreSQL ──
# Dashboard Neon → Connection Details → Connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# ── Authentification ──
JWT_SECRET=change_moi_par_une_chaine_aleatoire_longue
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=10

# ── Serveur ──
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ── Rédaction des rapports (console.groq.com/keys) ──
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# ── Paiement ──
# simulation : la commande est validée dans la plateforme elle-même. Aucun
#              débit, aucun compte externe, aucune configuration. C'est le
#              mode par défaut : laissez cette section telle quelle pour
#              développer et faire des démonstrations.
# paypal     : transaction PayPal réelle. Exige les identifiants ci-dessous ;
#              s'ils manquent, le serveur repasse automatiquement en simulation.
PAIEMENT_MODE=simulation

# Devise d'affichage et de comptabilité du catalogue
DEVISE=TND

# ── PayPal — FACULTATIF, uniquement si PAIEMENT_MODE=paypal ──
# À créer sur developer.paypal.com → Apps & Credentials.
# sandbox : comptes de test, aucun argent réel
# live    : paiements réels — à ne basculer qu'en production
#PAYPAL_ENV=sandbox
#PAYPAL_CLIENT_ID=
#PAYPAL_CLIENT_SECRET=
#
# Le dinar tunisien n'est pas une devise acceptée par PayPal : les tarifs
# restent affichés en TND et la transaction est présentée dans la devise
# ci-dessous, convertie à ce taux.
#PAYPAL_CURRENCY=EUR
#PAYPAL_TAUX_TND=0.29
#PAYPAL_LOCALE=fr_FR
