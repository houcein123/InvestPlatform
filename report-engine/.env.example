# ── Base de données PostgreSQL (Neon) ──
# Le moteur lit les données sectorielles et écrit les rapports produits.
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# ── Authentification interne ──
# Jeton PARTAGÉ avec le backend Spring Boot (app.report-engine.token).
# C'est la seule authentification du moteur : il fabrique des rapports sans
# vérifier de droit d'accès, cette vérification appartient au backend.
# Ne jamais exposer ce service publiquement.
REPORT_ENGINE_TOKEN=changez_moi_par_une_chaine_aleatoire_longue

# ── Serveur ──
PORT=3001

# ── Rédaction des rapports (console.groq.com/keys) ──
# UNE SEULE clé par ligne. dotenv coupe la valeur au premier « # » : deux clés
# collées sur une ligne aboutissent à utiliser silencieusement la première.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Groq retire régulièrement des modèles de son catalogue. Vérifier ceux
# auxquels la clé donne accès avec : npm run modeles
GROQ_MODEL=openai/gpt-oss-120b

# Devise d'affichage dans les documents produits
DEVISE=TND

# ── Paiement ──
# simulation : la commande est validée dans la plateforme, aucun débit.
# paypal     : transaction réelle via l'API Orders v2.
PAIEMENT_MODE=simulation

# À créer sur developer.paypal.com → Apps & Credentials.
# Le script scripts/demarrer-backend.ps1 les transmet au backend.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Le dinar tunisien n'est pas accepté par PayPal : les tarifs restent en TND
# et la transaction est présentée dans la devise ci-dessous, à ce taux.
PAYPAL_CURRENCY=EUR
PAYPAL_TAUX_TND=0.29
PAYPAL_LOCALE=fr_FR

# Nécessaire pour VÉRIFIER LA SIGNATURE des notifications PayPal.
# Sans lui, les webhooks reçus sont rejetés.
PAYPAL_WEBHOOK_ID=
